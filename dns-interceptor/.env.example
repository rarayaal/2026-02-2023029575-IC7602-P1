# Variables de entorno del DNS Interceptor.

# Dirección donde escucha el socket UDP del Interceptor.
INTERCEPTOR_BIND_ADDR=0.0.0.0

# Puerto UDP donde escucha el Interceptor.
# El estándar DNS es 53, pero en Linux/macOS requiere privilegios de root por lo que se usa uno alternativo para desarrollo local.
INTERCEPTOR_UDP_PORT=5353

# URL base del DNS API (sin trailing slash), usada para delegar paquetes no estándar (T06).
# Por defecto apunta al mock_dns_api local; en integración real apunta al DNS API de Luis.
DNS_API_URL=http://localhost:8081

# Timeout (ms) de las solicitudes HTTP al DNS API.
DNS_API_TIMEOUT_MS=5000

# Puerto donde escucha el mock_dns_api.
MOCK_API_PORT=8081

