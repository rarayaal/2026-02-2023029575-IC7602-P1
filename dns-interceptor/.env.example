# Variables de entorno del DNS Interceptor.

# Dirección donde escucha el socket UDP del Interceptor.
INTERCEPTOR_BIND_ADDR=0.0.0.0

# Puerto UDP donde escucha el Interceptor.
# El estándar DNS es 53, pero en Linux/macOS requiere privilegios de root por lo que se usa uno alternativo para desarrollo local.
INTERCEPTOR_UDP_PORT=5353
