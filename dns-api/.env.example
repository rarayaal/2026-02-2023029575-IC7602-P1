# Configuracion del DNS API (IC-7602, Proyecto 1)
# Copiar como .env y ajustar. El archivo .env no se versiona.

# Interfaz en la que escucha el API. 0.0.0.0 para que sea alcanzable desde otros contenedores.
DNS_API_HOST=0.0.0.0
DNS_API_PORT=8080

# Tope de peticiones que el API atiende al mismo tiempo.
DNS_API_MAX_THREADS=100

# Proyecto de Supabase. Ambas son obligatorias: sin ellas el API no arranca.
# La llave service_role salta la seguridad por filas, asi que solo la usa el API, nunca la UI.
SUPABASE_URL=https://wklojaeiiasfdofstiim.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_6Cn2140x9-G34dGk7YVc4w_OIGULm5t

# Servidor DNS remoto al que el API delega los paquetes que recibe en /api/dns_resolver.
# El enunciado exige que esta direccion se reciba por configuracion, no quemada en el codigo.
DNS_SERVER_IP=8.8.8.8
DNS_SERVER_PORT=53
DNS_TIMEOUT_MS=3000
